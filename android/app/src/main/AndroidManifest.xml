<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Notifications push (FCM) : petite icône monochrome, couleur d'accent et canal par
             défaut utilisés par le système quand l'app est FERMÉE (message « notification »
             affiché sans JavaScript). Le canal baobab_default est aussi créé par le code
             (src/lib/nativePush.js) ; send-push envoie avec ce même identifiant. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_baobab" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/bb_notification_color" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="baobab_default" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Liens profonds (Android App Links) vers le domaine web public. L'hôte vient de
                 manifestPlaceholders (android/app/build.gradle), lui-même lu dans
                 src/config/publicOrigin.json : UNE seule source pour changer de domaine.
                 autoVerify : Android vérifie https://<hôte>/.well-known/assetlinks.json (voir
                 public/.well-known/assetlinks.json et MOBILE.md). Chemins en liste blanche. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${deepLinkHost}" />
                <data android:pathPrefix="/event/" />
                <data android:pathPrefix="/community/" />
                <data android:pathPrefix="/profile/" />
                <data android:pathPrefix="/messages/" />
                <data android:path="/update-password" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ : permission de notification (demandée au geste de l'utilisateur, jamais au premier lancement). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Localisation APPROXIMATIVE seulement (étape 3b). Baobab n'a pas besoin de la position
         précise : les coordonnées sont arrondies à 2 décimales (~1,1 km) avant d'être envoyées
         (src/lib/geolocation.js) et le serveur n'expose que des distances approximatives.
         ACCESS_FINE_LOCATION n'est donc volontairement PAS déclarée (la déclarer ferait afficher
         le choix « précise » à l'utilisateur sans bénéfice). Le plugin @capacitor/geolocation ne
         déclare aucune permission lui-même. Pas de <uses-feature gps> : le GPS n'est pas requis. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Appareil photo / galerie : AUCUNE permission à déclarer. @capacitor/camera ouvre l'application
         Appareil photo du système (intent IMAGE_CAPTURE) et le sélecteur de photos système
         (Photo Picker, Android 13+) : déclarer CAMERA ici obligerait au contraire l'app à obtenir
         cette permission avant toute prise de photo. Retour haptique : le plugin @capacitor/haptics
         ajoute lui-même VIBRATE (permission « normale », aucune invite). -->
</manifest>
