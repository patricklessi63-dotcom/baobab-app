# Normalise les fins de ligne : LF dans le dépôt, quelle que soit la
# plateforme du contributeur. Supprime les avertissements
# « LF will be replaced by CRLF » à chaque commit sous Windows.
* text=auto eol=lf

# Fichiers binaires — jamais de conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary

# Scripts Gradle/Android (Capacitor) : gradlew en LF (sinon « bad interpreter »
# sous Linux/CI), gradlew.bat en CRLF (requis par cmd.exe).
android/gradlew text eol=lf
*.bat text eol=crlf
