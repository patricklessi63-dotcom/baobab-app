{
  "name": "baobab-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:maskable": "node scripts/generate-maskable-icon.mjs",
    "cap:sync": "vite build && cap sync",
    "cap:open:android": "cap open android",
    "android:build:debug": "node scripts/android-gradle.mjs assembleDebug",
    "android:build:release": "node scripts/android-gradle.mjs bundleRelease",
    "assets:sources": "node scripts/generate-native-asset-sources.mjs",
    "assets:android": "capacitor-assets generate --android --assetPath assets"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^5.12.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
