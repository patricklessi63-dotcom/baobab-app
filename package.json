{
  "name": "baobab-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:maskable": "node scripts/generate-maskable-icon.mjs",
    "cap:sync": "vite build && cap sync",
    "cap:open:android": "cap open android",
    "cap:sync:ios": "vite build && cap sync ios",
    "cap:open:ios": "cap open ios",
    "android:build:debug": "node scripts/android-gradle.mjs assembleDebug",
    "android:build:release": "node scripts/android-gradle.mjs bundleRelease",
    "ios:build:sim": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "assets:sources": "node scripts/generate-native-asset-sources.mjs",
    "assets:android": "capacitor-assets generate --android --assetPath assets",
    "assets:ios": "capacitor-assets generate --ios --assetPath assets"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "plist": "^5.0.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^5.12.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
