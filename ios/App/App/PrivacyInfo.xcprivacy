<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manifeste de confidentialité de l'APP (Apple, obligatoire depuis le 1er mai 2024).
	     Les plugins/SDK fournissent leur propre manifeste ; celui-ci décrit les données de Baobab,
	     recoupées avec STORES.md §1 et §8 (étiquettes App Privacy). À garder cohérent avec App Store Connect. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- API « à raison requise » : AUCUNE utilisée par le code de l'app ni par Capacitor 8.5.2 / les 9 plugins
	     (recherche faite dans node_modules/@capacitor : pas de UserDefaults, d'horodatage de fichier,
	     d'heure de démarrage, d'espace disque, de clavier actif). Si Apple signale ITMS-91053 après un envoi,
	     ajouter ici la catégorie et la raison indiquées dans l'e-mail (voir MOBILE.md, étape 5). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
